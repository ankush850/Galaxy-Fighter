--
-- Galaxy Fighter - Solar2D Android & iOS Build Settings
-- Target SDK: 34 (Android 14 Ready), Min SDK: 21
--

settings =
{
	orientation =
	{
		default = "landscapeRight",
		supported = { "landscapeRight", "landscapeLeft" },
	},

	android =
	{
		minSdkVersion = "21",
		targetSdkVersion = "34",
		isLandscape = true,
		usesExpansionFile = false,
		supportsScreens =
		{
			smallScreens = true,
			normalScreens = true,
			largeScreens = true,
			xlargeScreens = true,
		},
		usesPermissions =
		{
			"android.permission.INTERNET",
			"android.permission.ACCESS_NETWORK_STATE",
			"android.permission.VIBRATE",
			"android.permission.WAKE_LOCK",
		},
		usesFeatures =
		{
			{ name = "android.hardware.touchscreen", required = true },
			{ name = "android.hardware.touchscreen.multitouch", required = true },
		},
	},

	iphone =
	{
		xcassets = "Images.xcassets",
		plist =
		{
			UIStatusBarHidden = true,
			UILaunchStoryboardName = "LaunchScreen",
			UIRequiresFullScreen = true,
			UIPrerenderedIcon = true,
		},
	},

	plugins =
	{
	},

	excludeFiles =
	{
		all = { "Icon.png", "Icon-*dpi.png", "Images.xcassets", "*.md", "Dockerfile", "server.js", "sw.js" },
		android = { "LaunchScreen.storyboardc", },
	},
}
